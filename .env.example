# Leftover Tile Project Planner — Environment Variable Template
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Private Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe Payments Configuration (Used in Phase 3)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
