# Leftover Tile Project Planner — Environment Variable Template
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Direct PostgreSQL Connection Strings (Obtain from Settings -> Database)
# Shared transaction-mode pooler (port 6543, IPv4-only, used for application queries)
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Shared session-mode pooler (port 5432, used for schema migrations and DDL)
DIRECT_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Private Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend Transactional Email Configuration (https://resend.com)
RESEND_API_KEY="re_placeholder"
RESEND_FROM_EMAIL="Leftover Tile Planner <leftover@yourdomain.com>"
ADMIN_EMAIL="piyakshi90@gmail.com"
ADMIN_NOTIFICATION_EMAILS="piyakshi90@gmail.com,one2ai@aol.com"

# Stripe Payments Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
